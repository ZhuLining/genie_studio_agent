[Unit]
Description=GSA Taskflow Executor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=u
WorkingDirectory=/home/u/project/gsa_taskflow_executor
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/gsa-taskflow-executor/gsa-taskflow-executor.env
# GDK/DDS 依赖 LD_LIBRARY_PATH/PYTHONPATH 等进程启动前环境；不要依赖人工 shell source。
EnvironmentFile=-/etc/gsa-taskflow-executor/gdk.env
ExecStartPre=/home/u/project/gsa_taskflow_executor/.venv/bin/gsa-taskflow-executor --deployment-config-check
ExecStartPre=/home/u/project/gsa_taskflow_executor/.venv/bin/gsa-taskflow-executor --gdk-env-check
ExecStart=/home/u/project/gsa_taskflow_executor/.venv/bin/gsa-taskflow-executor --listen
Restart=on-failure
RestartSec=3
# 当前现场沿用 /home/u/project 联调目录，日志写入项目 logs；
# GSA_DATA_ROOT 若继续使用 /data/gsa，需要确保 u 用户具备写权限。
ReadWritePaths=/home/u/project/gsa_taskflow_executor/logs /data/gsa
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
# G2 默认 GDK 环境位于 /home/u/.cache/agibot/app；仅以只读 bind 暴露给 executor。
BindReadOnlyPaths=-/home/u/.cache/agibot/app
ProtectSystem=full

[Install]
WantedBy=multi-user.target
