# GSA Taskflow Executor GDK/DDS runtime environment for systemd.
#
# systemd EnvironmentFile 只接受静态 KEY=VALUE，不会执行 source、命令替换或 shell 变量展开。
# 在 G2 现场先用交互 shell source /home/u/.cache/agibot/app/env.sh，确认可 import agibot_gdk
# 后，再把其中和 GDK/DDS 相关的最终值固化到 /etc/gsa-taskflow-executor/gdk.env。
# 不要在这里写入 token、密码或其他凭据。

# Python 包路径：当 agibot_gdk 不在 executor venv 内时，必须在 Python 进程启动前注入。
# PYTHONPATH=/home/u/.cache/agibot/app/python

# GDK 原生库路径：导入 agibot_gdk 依赖的 .so 必须在 Python 进程启动前可见。
# LD_LIBRARY_PATH=/home/u/.cache/agibot/app/lib

# DDS / ROS2 相关变量请按目标 G2 机器 env.sh 的实际输出填写；下面只是常见 key 提示。
# CYCLONEDDS_URI=file:///home/u/.cache/agibot/app/config/cyclonedds.xml
# FASTRTPS_DEFAULT_PROFILES_FILE=/home/u/.cache/agibot/app/config/fastdds.xml
# RMW_IMPLEMENTATION=
# ROS_DOMAIN_ID=
# AMENT_PREFIX_PATH=
