# GSA Taskflow Executor runtime config.
# Production runtime calls QR SDKs and verified GDK ABS_JOINT/ABS_POSE interfaces
# behind safety gates.

# Required: set the broker address shared by the client and executor.
# If the broker intentionally runs on this Ubuntu host, set mqtt://127.0.0.1:1883
# and also set ALLOW_LOCAL_MQTT_BROKER=1 below.
MQTT_BROKER_URL=
ALLOW_LOCAL_MQTT_BROKER=
MQTT_CLIENT_ID=gsa-taskflow-executor-edge-001
TASKFLOW_INPUT_TOPIC=gsa/self/taskflow_yaml
TASKFLOW_CANCEL_TOPIC_FILTER=gsa/self/taskflow/+/cancel
TASKFLOW_STATUS_TOPIC_TEMPLATE=gsa/self/{aid}/status
MQTT_STATUS_QOS=0
MQTT_TERMINAL_STATUS_QOS=1
MQTT_TERMINAL_STATUS_RETAIN=false
MQTT_TERMINAL_STATUS_WAIT_TIMEOUT=2.0
TASKFLOW_QUEUE_MAXSIZE=16
TASKFLOW_QUEUE_FULL_POLICY=reject
ROBOT_STATE_QUEUE_MAXSIZE=8
ROBOT_STATE_QUEUE_FULL_POLICY=reject
DIAGNOSTICS_MQTT_CONNECT_TIMEOUT=2.0
PAYLOAD_MAX_STRING_LENGTH=512
PAYLOAD_MAX_COLLECTION_ITEMS=20
PAYLOAD_MAX_DEPTH=6
PAYLOAD_INCLUDE_FULL_VARIABLES=false
ROBOT_CURRENT_POSE_REQUEST_TOPIC=gsa/self/robot/state/get_current_pose/request
ROBOT_CURRENT_POSE_RESPONSE_TOPIC=gsa/self/robot/state/get_current_pose/response
ROBOT_IDENTITY_REQUEST_TOPIC=gsa/self/robot/state/get_robot_identity/request
ROBOT_IDENTITY_RESPONSE_TOPIC=gsa/self/robot/state/get_robot_identity/response
ROBOT_CAMERA_FRAME_REQUEST_TOPIC=gsa/self/robot/state/get_camera_frame/request
ROBOT_CAMERA_FRAME_RESPONSE_TOPIC=gsa/self/robot/state/get_camera_frame/response
ROBOT_CAMERA_CALIBRATION_REQUEST_TOPIC=gsa/self/robot/state/get_camera_calibration/request
ROBOT_CAMERA_CALIBRATION_RESPONSE_TOPIC=gsa/self/robot/state/get_camera_calibration/response
ROBOT_CAMERA_CAPTURE_START_REQUEST_TOPIC=gsa/self/robot/state/camera_capture/start/request
ROBOT_CAMERA_CAPTURE_START_RESPONSE_TOPIC=gsa/self/robot/state/camera_capture/start/response
ROBOT_CAMERA_CAPTURE_STOP_REQUEST_TOPIC=gsa/self/robot/state/camera_capture/stop/request
ROBOT_CAMERA_CAPTURE_STOP_RESPONSE_TOPIC=gsa/self/robot/state/camera_capture/stop/response
ROBOT_CAMERA_CAPTURE_FRAME_TOPIC_TEMPLATE=gsa/self/robot/state/camera_capture/{sessionId}/frame
GSA_DATA_ROOT=/data/gsa
QR_MAPPING_PROJECT_PATH_REQUEST_TOPIC=gsa/self/robot/qr_mapping/get_qr_project_path/request
QR_MAPPING_PROJECT_PATH_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/get_qr_project_path/response
QR_MAPPING_PROJECT_SNAPSHOT_REQUEST_TOPIC=gsa/self/robot/qr_mapping/get_qr_project_snapshot/request
QR_MAPPING_PROJECT_SNAPSHOT_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/get_qr_project_snapshot/response
QR_MAPPING_PROJECT_LIST_REQUEST_TOPIC=gsa/self/robot/qr_mapping/list_qr_projects/request
QR_MAPPING_PROJECT_LIST_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/list_qr_projects/response
QR_MAPPING_CAPTURE_START_REQUEST_TOPIC=gsa/self/robot/qr_mapping/start_capture/request
QR_MAPPING_CAPTURE_START_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/start_capture/response
QR_MAPPING_CAPTURE_STOP_REQUEST_TOPIC=gsa/self/robot/qr_mapping/stop_capture/request
QR_MAPPING_CAPTURE_STOP_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/stop_capture/response
QR_MAPPING_CAPTURE_FRAME_TOPIC_TEMPLATE=gsa/self/robot/qr_mapping/capture/{sessionId}/frame
QR_MAPPING_BUILD_MAP_REQUEST_TOPIC=gsa/self/robot/qr_mapping/build_map/request
QR_MAPPING_BUILD_MAP_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/build_map/response
QR_MAPPING_DELETE_MAP_REQUEST_TOPIC=gsa/self/robot/qr_mapping/delete_map/request
QR_MAPPING_DELETE_MAP_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/delete_map/response
QR_MAPPING_PCD_PREVIEW_REQUEST_TOPIC=gsa/self/robot/qr_mapping/read_pcd_preview/request
QR_MAPPING_PCD_PREVIEW_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/read_pcd_preview/response
POINT_RECORDING_SAVE_TARGET_REQUEST_TOPIC=gsa/self/robot/qr_mapping/save_target_point/request
POINT_RECORDING_SAVE_TARGET_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/save_target_point/response
POINT_RECORDING_SAVE_INITIAL_PHOTO_REQUEST_TOPIC=gsa/self/robot/qr_mapping/save_initial_photo_point/request
POINT_RECORDING_SAVE_INITIAL_PHOTO_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/save_initial_photo_point/response
POINT_RECORDING_SUBMIT_REQUEST_TOPIC=gsa/self/robot/qr_mapping/submit_point_recording/request
POINT_RECORDING_SUBMIT_RESPONSE_TOPIC=gsa/self/robot/qr_mapping/submit_point_recording/response
QR_MAPPING_SDK_PATH=
QR_MAPPING_SDK_PYTHON=python3
QR_MAPPING_BUILD_TIMEOUT_SECONDS=300
QR_LOCALIZE_SDK_PATH=
QR_LOCALIZE_SDK_PYTHON=python3
QR_LOCALIZE_TIMEOUT_SECONDS=120
# Required: must match the client status subscription / target robot AID.
# Never use the development default gsa-dev in production.
EXECUTOR_AID=
EXECUTOR_MODE=gdk
EXECUTOR_LOG_DIR=/var/log/gsa-taskflow-executor
SKILL_REGISTRY_FILE=/etc/gsa-taskflow-executor/skills.yaml

# GDK/DDS 的 PYTHONPATH、LD_LIBRARY_PATH 和 DDS 配置必须由 systemd 在进程启动前注入。
# 请放到 /etc/gsa-taskflow-executor/gdk.env，模板见 deploy/gsa-taskflow-executor.gdk.env.example。

# Required before taskflow can execute GDK control.
# ENABLE_GDK_CONTROL=1
# CONFIRM_GDK_CONTROL=TASKFLOW_ABS_JOINT

# Optional ABS_POSE safety limits for QR localization -> pose-control validation.
# Defaults: 0.30m translation, 90deg rotation, 0.02s pose command lifetime.
# Hard caps: 0.50m translation, 180deg rotation, 0.20s lifetime.
# TASKFLOW_ABS_POSE_MAX_TRANSLATION_M=0.30
# TASKFLOW_ABS_POSE_MAX_ROTATION_DEG=90
# TASKFLOW_ABS_POSE_LIFE_TIME_SECONDS=0.02

# Future force-control runtime must use CONFIRM_GDK_CONTROL=TASKFLOW_FORCE_CONTROL.
