# GSA Taskflow Executor runtime config.
# Phase 1 is mock only: no GDK import, no robot control command.

MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=gsa-taskflow-executor-edge-001
TASKFLOW_INPUT_TOPIC=taskflow/taskflow_yaml
TASKFLOW_STATUS_TOPIC_TEMPLATE=taskflow/{aid}/status
EXECUTOR_AID=gsa-dev
EXECUTOR_MODE=mock
EXECUTOR_LOG_DIR=/var/log/gsa-taskflow-executor
SKILL_REGISTRY_FILE=/etc/gsa-taskflow-executor/skills.yaml
